<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BabyTracker.Models"
             x:Class="BabyTracker.Views.HistoryPage"
             Title="History">

    <Grid RowSpacing="0">

        <!-- Filter Buttons -->
        <Grid Grid.Row="0" Padding="16" ColumnSpacing="8" BackgroundColor="{StaticResource SurfaceColor}">
            <Button x:Name="AllFilterButton"
                    Text="All"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="40"
                    Clicked="OnFilterClicked"
                    Grid.Column="0" />
            <Button x:Name="WakeupsFilterButton"
                    Text="☀️ Wakeups"
                    Style="{StaticResource ButtonBase}"
                    HeightRequest="40"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    TextColor="{StaticResource TextColor}"
                    BorderColor="{StaticResource BorderColor}"
                    BorderWidth="1"
                    Clicked="OnFilterClicked"
                    Grid.Column="1" />
            <Button x:Name="FeedingsFilterButton"
                    Text="🍼 Feedings"
                    Style="{StaticResource ButtonBase}"
                    HeightRequest="40"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    TextColor="{StaticResource TextColor}"
                    BorderColor="{StaticResource BorderColor}"
                    BorderWidth="1"
                    Clicked="OnFilterClicked"
                    Grid.Column="2" />
        </Grid>

        <!-- Records List -->
        <CollectionView x:Name="RecordsCollectionView"
                        Grid.Row="1"
                        Margin="16,8"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BabyRecord">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           BackgroundColor="{StaticResource DangerColor}"
                                           CommandParameter="{Binding Id}"
                                           Invoked="OnDeleteSwiped" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Style="{StaticResource CardFrame}">
                            <Grid ColumnSpacing="12">
                                <!-- Icon -->
                                <Label x:Name="RecordIcon"
                                       FontSize="28"
                                       VerticalOptions="Center"
                                       Grid.Column="0" />

                                <!-- Details -->
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center" Grid.Column="1">
                                    <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextColor}">
                                        <Label.Text>
                                            <Binding Path="Type" StringFormat="{}{0}" />
                                        </Label.Text>
                                    </Label>
                                    <Label FontSize="12" TextColor="{StaticResource TextSecondaryColor}">
                                        <Label.Text>
                                            <Binding Path="Timestamp" StringFormat="{}{0:MMM dd, yyyy}" />
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Time -->
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2">
                                    <Label FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextColor}">
                                        <Label.Text>
                                            <Binding Path="Timestamp" StringFormat="{}{0:hh:mm}" />
                                        </Label.Text>
                                    </Label>
                                    <Label FontSize="12" TextColor="{StaticResource TextSecondaryColor}">
                                        <Label.Text>
                                            <Binding Path="Timestamp" StringFormat="{}{0:tt}" />
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="📝" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No records yet" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextColor}" 
                           HorizontalOptions="Center" />
                    <Label Text="Start recording by tapping the buttons on the main page" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondaryColor}" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>

</ContentPage>
